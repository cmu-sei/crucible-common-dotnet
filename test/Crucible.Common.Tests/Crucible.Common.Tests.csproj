<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Crucible.Common.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Builds the test project as a Microsoft.Testing.Platform app, which xunit.v3 4 requires on the
         .NET 10 SDK; global.json selects the same runner for `dotnet test`. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- 4.14.0 is the first release built against SSH.NET 2026.0.0. Earlier versions carry the
         vulnerable 2025.1.0, and pinning SSH.NET over them would cross a major version under Testcontainers. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Crucible.Common.Authentication\Crucible.Common.Authentication.csproj" />
    <!-- Reference Generators as both analyzer (for source gen) and assembly (for tests) -->
    <ProjectReference Include="..\..\src\Crucible.Common.EntityEvents.Generators\Crucible.Common.EntityEvents.Generators.csproj" OutputItemType="Analyzer" />
    <ProjectReference Include="..\..\src\Crucible.Common.Utilities\Crucible.Common.Utilities.csproj" />
  </ItemGroup>

  <!-- Include EntityEvents source files directly (source-only library) -->
  <ItemGroup>
    <Compile Include="..\..\src\Crucible.Common.EntityEvents\src\**\*.cs" Link="EntityEvents\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
